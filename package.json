{
  "name": "orthodrill",
  "version": "0.0.0",
  "private": true,
  "description": "A browser drill for orthographic projection.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
